# Copy this file to .env and fill in your own key.
# The app runs fine without one — it just falls back to a distance-based
# estimate instead of live traffic data for walk/auto legs.

# Get a free key at https://console.cloud.google.com/ (enable "Directions API")
# The free monthly quota is generous — a single-corridor pilot with a few
# dozen testers won't come close to it.
GOOGLE_MAPS_API_KEY=

PORT=3000
